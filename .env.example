# La demo non richiede nessuna chiave: puoi non creare affatto il file .env.
# Il .env non va mai committato.

# Nome del modello mostrato in dashboard (default "Simulato")
# MODEL_LABEL=Simulato

# Database usato da API e demo_seed (default data/accounts.db)
# ACCOUNTS_DB=data/accounts.db

# Solo se il frontend e' su un dominio diverso dall'API (vedi render.yaml)
# ALLOWED_ORIGINS=https://tuo-sito.onrender.com

# Le chiavi per gli agenti veri (OPENAI_API_KEY, TAVILY_API_KEY, ...) sono descritte
# in COME_RENDERLO_REALE.txt, con il .env.example completo in fondo al file.
