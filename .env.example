# Copia in .env e riempi i valori. Il .env NON va mai committato.
# Ogni variabile qui sotto e' letta da almeno una riga di codice: se ne aggiungi
# una che nessuno legge, tra sei mesi non ricorderai se serve.

# ---------------------------------------------------------------------------
# Modelli
# ---------------------------------------------------------------------------

# Obbligatoria: e' il default dell'OpenAI Agents SDK e serve anche per il
# tracing. Con USE_MANY_MODELS=false basta questa.
OPENAI_API_KEY=sk-...

# Modello dei trader (default gpt-5.4-mini). Gratis: gemini-2.5-flash con GOOGLE_API_KEY
# TRADER_MODEL=gemini-2.5-flash

# Opzionali: servono con USE_MANY_MODELS=true o con TRADER_MODEL=gemini-*, dove ogni trader gira
# su un provider diverso (vedi get_model() in backend/traders.py)
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
# GROK_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Dati e ricerca
# ---------------------------------------------------------------------------

# Prezzi azionari reali. SENZA questa chiave il progetto funziona lo stesso:
# backend/market_simulator.py genera prezzi deterministici e plausibili.
# Lasciala vuota per far girare tutto a costo zero di dati.
# MASSIVE_API_KEY=

# Ricerca web dell'agente Researcher, via server MCP tavily-mcp (npx).
# Senza questa chiave il researcher perde la ricerca e resta solo il fetch.
TAVILY_API_KEY=tvly-...

# ---------------------------------------------------------------------------
# Notifiche push (ntfy.sh)
# ---------------------------------------------------------------------------

# Topic ntfy: scegline uno lungo e non indovinabile. Chiunque lo conosca puo'
# leggere e scrivere sul canale. Iscriviti allo stesso topic dall'app ntfy.
NTFY_TOPIC=trading-floor-cambia-questo-in-qualcosa-di-random

# Server alternativo, solo per istanze self-hosted
# NTFY_SERVER=https://ntfy.sh

# Bearer token, solo se il topic e' protetto
# NTFY_TOKEN=tk_...

# URL della dashboard: diventa il link aperto al tap sulla notifica
# DASHBOARD_URL=https://autonomous-traders.onrender.com

# ---------------------------------------------------------------------------
# Comportamento del motore (backend/trading_floor.py)
# ---------------------------------------------------------------------------

# Ogni quanti minuti gira un ciclo. Ogni ciclo lancia 4 trader e costa crediti.
# In sviluppo tienilo alto, o il conto sale mentre guardi la dashboard.
RUN_EVERY_N_MINUTES=60

# true per farlo girare anche a mercato chiuso (utile per fare demo la sera)
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# true assegna un modello diverso a ciascun trader, false usa lo stesso per
# tutti e quattro (confronto piu' pulito tra strategie, non tra modelli)
USE_MANY_MODELS=false
