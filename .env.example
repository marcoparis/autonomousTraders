# Copia questo file in .env e inserisci le chiavi. Il .env non va mai committato.

# --- Modello degli agenti ---------------------------------------------------

# Modello di default dei trader (in traders.toml si puo' scegliere per singolo trader).
# Il nome decide il provider: "gpt-..." OpenAI, "gemini-..." Google, "deepseek-..."
# DeepSeek, "grok-..." xAI, "groq:..." Groq, "provider/modello" OpenRouter.
TRADER_MODEL=gpt-5.4-mini

# OpenAI: serve per i modelli gpt e per il tracing dell'Agents SDK
OPENAI_API_KEY=sk-...

# Solo se usi un altro provider
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# GROK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Dati di mercato e ricerca (obbligatorie) -------------------------------

# Prezzi reali da Massive (ex Polygon.io), massive.com
MASSIVE_API_KEY=

# Ricerca web del researcher, tavily.com (piano gratuito: 1000 crediti al mese)
TAVILY_API_KEY=tvly-...

# --- Notifiche sul telefono (facoltative) -----------------------------------

# Topic ntfy.sh: sceglilo lungo e casuale, chi lo conosce puo' leggere i messaggi.
# Iscriviti allo stesso topic dall'app ntfy per ricevere le notifiche.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# Link aperto toccando la notifica
# DASHBOARD_URL=https://trading-floor-s5tt.onrender.com

# --- Motore -----------------------------------------------------------------

# Minuti tra un ciclo e l'altro quando il motore gira in continuo
RUN_EVERY_N_MINUTES=60

# true: un solo ciclo e poi esce (lo usa GitHub Actions)
RUN_ONCE=false

# true: gira anche a borsa chiusa (con prezzi della chiusura precedente)
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# Secondi di pausa tra un trader e l'altro, per i limiti dei piani gratuiti
PAUSE_BETWEEN_TRADERS_SECONDS=30

# Percorsi alternativi, di solito non servono
# ACCOUNTS_DB=data/accounts.db
# TRADERS_CONFIG=traders.toml
